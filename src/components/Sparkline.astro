---
interface Props { points: number[] }
const { points } = Astro.props;
const W = 160, H = 36;
const min = Math.min(...points), max = Math.max(...points);
const span = max - min || 1;
const coords = points.map((p, i) => `${(i / Math.max(points.length - 1, 1)) * W},${H - 2 - ((p - min) / span) * (H - 4)}`).join(' ');
---
{points.length >= 2 && (
  <svg class="spark" width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Stars over the last ${points.length} days: from ${points[0]} to ${points[points.length - 1]}`}>
    <polyline points={coords} />
  </svg>
)}
